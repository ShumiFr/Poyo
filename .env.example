# Copie ce fichier en .env et remplis avec les valeurs de ton projet Supabase
# (Project Settings → API). Ces deux clés sont publiques (côté client) : la
# sécurité réelle vient de la Row Level Security en base.
VITE_SUPABASE_URL=https://ton-projet.supabase.co
VITE_SUPABASE_ANON_KEY=ta-cle-anon-publique
